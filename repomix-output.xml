    <Suspense fallback={<div>Loading...</div>}>
      <Routes>
        <Route path="/" element={<Navigate to="/auth" />} />
        <Route path="/auth" element={<LoginPage />} />
        {/* <Route element={<PrivateRoute />}> */}
          <Route path="/home" element={<Home />} />
        {/* </Route> */}
      </Routes>
    </Suspense>
  );
};

